---
import type { CollectionEntry } from 'astro:content';
import PreviewMedia from './PreviewMedia.astro';
import Laurels from './Laurels.astro';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { data } = project;
const num = String(data.number).padStart(2, '0');
const href = `/work/${project.id}/`;
---

<article class:list={['card', { 'card--featured': data.featured }]}>
  <div class="card__media" transition:name={`media-${project.id}`}>
    <PreviewMedia project={data} />
  </div>
  <div class="card__meta">
    <div>
      <h3 class="card__title">
        <a class="card__link" href={href}>
          <span class="card__num">{num}</span>
          <span class="card__slash" aria-hidden="true">/</span>
          {data.title}
        </a>
      </h3>
      <p class="card__category">{data.category}</p>
    </div>
    <div class="card__aside">
      {
        data.featured && data.awards?.length && (
          <div class="card__awards">
            {data.awards.map((a) => (
              <Laurels {...a} />
            ))}
          </div>
        )
      }
      <span class="card__arrow" aria-hidden="true">↗</span>
    </div>
  </div>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .card__media {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--color-media);
  }
  .card--featured .card__media {
    aspect-ratio: 2 / 1;
  }
  .card__meta {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-4);
  }
  .card__title {
    font-size: clamp(1.375rem, 2.4vw, 1.75rem);
  }
  .card__num,
  .card__slash {
    font-family: var(--font-body);
    font-size: var(--text-small);
    color: var(--color-muted);
    font-variant-numeric: lining-nums tabular-nums;
    vertical-align: 0.2em;
  }
  .card__slash {
    margin-inline: 0.3em 0.45em;
    color: var(--color-rule);
  }
  /* Stretch the title link over the whole card so the media is clickable too. */
  .card__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .card__link:focus-visible {
    outline: none;
  }
  .card:has(.card__link:focus-visible) {
    outline: 1px solid var(--color-accent);
    outline-offset: 6px;
  }
  .card__category {
    margin-top: var(--space-1);
    font-size: var(--text-small);
    color: var(--color-muted);
  }
  .card__aside {
    display: flex;
    align-items: center;
    gap: var(--space-5);
  }
  .card__awards {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }
  @media (max-width: 640px) {
    .card__awards {
      gap: var(--space-3);
    }
  }
  .card__arrow {
    color: var(--color-accent);
    font-size: 1.25rem;
    line-height: 1;
    transition: transform var(--duration) var(--ease-out);
  }
  .card:hover .card__arrow {
    transform: translate(3px, -3px);
  }
  .card__media :global(.media) {
    transition: opacity var(--duration) var(--ease-out);
  }
  .card:hover .card__media :global(.media) {
    opacity: 0.92;
  }
  @media (max-width: 640px) {
    .card--featured .card__media {
      aspect-ratio: 16 / 9;
    }
    .card--featured .card__meta {
      flex-wrap: wrap;
    }
    .card--featured .card__aside {
      width: 100%;
      justify-content: space-between;
      align-items: flex-start;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .card__arrow,
    .card__media :global(.media) {
      transition: none;
    }
  }
</style>
